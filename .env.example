NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Trusted reverse proxy hops or subnets (default: loopback). Rejects 'true' or '*'.
TRUST_PROXY=loopback
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/anantalia_backend_dev?schema=public
# Required to enable auth routes: base64url encoding of at least 32 random bytes.
CSRF_SECRET=
# Required to enable TOTP-backed auth routes. TOTP_KEYRING is a JSON object of key IDs to 32-byte base64url keys.
TOTP_ACTIVE_KEY_ID=
TOTP_KEYRING=
# Required by password verification; choose reviewed values for each deployment.
ARGON2_MEMORY_COST=
ARGON2_TIME_COST=
ARGON2_PARALLELISM=
ARGON2_HASH_LENGTH=

# Optional external email webhook for inbox replies & email change OTP verification.
# SMTP_WEBHOOK_URL=https://your-mailer.example/send
# SMTP_WEBHOOK_SECRET=
# SMTP_WEBHOOK_TIMEOUT_MS=5000

# Optional external object storage upload webhook for CMS images (S3/R2 signed proxy).
# OBJECT_STORAGE_UPLOAD_URL=https://your-storage-proxy.example/upload
# OBJECT_STORAGE_TOKEN=

# Opt-in configuration for isolated PostgreSQL tests (NEVER point to dev/prod DBs).
# DATABASE_TEST_OPT_IN=I_CONFIRM_DISPOSABLE_DATABASE
# TEST_DATABASE_NAME=anantalia_validation_test
# TEST_DATABASE_ALLOWLIST=127.0.0.1:5433/anantalia_validation_test
# TEST_DATABASE_URL=postgresql://validation_user:PASSWORD@127.0.0.1:5433/anantalia_validation_test?schema=public
