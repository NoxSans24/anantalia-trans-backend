# Dependencies and package manager output
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment and secrets (keep safe examples trackable)
.env
.env.*
!.env.example
!.env.*.example

# Logs and runtime output
logs/
*.log
pids/
*.pid
*.pid.lock

# Coverage and build output
coverage/
dist/
build/

# Prisma generated client (if generated into the default location)
node_modules/.prisma/

# Local databases, dumps, and backups
*.db
*.sqlite
*.sqlite3
*.dump
*.backup
*.bak
*.bkp
# SQL backups are ignored only in conventional backup directories; other SQL,
# including Prisma migration files, remains trackable.
backup/*.sql
backups/*.sql
database-backups/*.sql
db/backups/*.sql

# Editor and operating system temporary files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
