{
  "name": "anantalia-trans-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/unit/*.test.js",
    "pretest": "npm run prisma:generate",
    "test:db": "node --env-file-if-exists=.env --test tests/integration/*.test.js",
    "pretest:db": "npm run prisma:generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
