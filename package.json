{
  "name": "anantalia-trans-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.js"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/unit/*.test.js",
    "pretest": "npm run prisma:generate",
    "test:db": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:db:isolated": "node scripts/run-disposable-db-suite.js",
    "pretest:db": "node tests/integration/require-database-test-opt-in.js && npm run prisma:generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:test": "node scripts/prisma-migrate-test.js",
    "bootstrap:admin": "node --env-file-if-exists=.env scripts/bootstrap-super-admin.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-presentation-demo.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
